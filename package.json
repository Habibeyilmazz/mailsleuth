{
  "name": "mailsleuth",
  "version": "0.1.0",
  "description": "Explainable suspicious-email analyzer that runs entirely in your browser, plus a JSON CLI.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "mailsleuth": "dist-cli/mailsleuth.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --port 4190 --strictPort",
    "build": "vite build && npm run build:cli",
    "build:cli": "vite build --config vite.cli.config.ts",
    "preview": "vite preview --port 4191 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fuzz": "FUZZ=1 vitest run test/fuzz.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "axe-core": "4.13.0",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
